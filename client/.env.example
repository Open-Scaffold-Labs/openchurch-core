# Override the API base URL at build time.
#
# Leave empty (the default) for the Vercel monorepo deploy where the
# client and api ship from the same project — relative URLs route
# through vercel.json's /api/:path* rewrite to api/index.js.
#
# Set to a full https URL only when client + api live on different
# hosts (e.g. Vercel static + a separate api on Railway / Fly / etc.).
VITE_API_URL=
