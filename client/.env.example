# Override the API base URL at build time.
#
# Leave empty (the default) for the Vercel monorepo deploy where the
# client and api ship from the same project — relative URLs route
# through vercel.json's /api/:path* rewrite to api/index.js.
#
# Set to a full https URL only when client + api live on different
# hosts (e.g. Vercel static + a separate api on Railway / Fly / etc.).
VITE_API_URL=

# Local-only Login helper. When set to true AND Vite is in `dev`
# (`import.meta.env.DEV`), Login shows a "Use demo account" button that
# fills the seeded demo credentials (see README, "Demo credentials").
#
# Production `vite build` compiles DEV to false and dead-code-eliminates
# the helper — the password literal never reaches the client bundle.
# Never set this in `.env.production` or a production deploy.
#
#   VITE_ENABLE_DEMO_LOGIN=true npm run dev
#
# VITE_ENABLE_DEMO_LOGIN=
#
# App Review credentials are server env only (SEED_APP_REVIEW_TENANT +
# APP_REVIEW_*). Never add a VITE_APP_REVIEW_* variable — production
# Vite would compile it into the client. See docs/APP-REVIEW-TENANT.md.

# Public Support / contact page (OC-READY-01-007). Shown on /contact
# and linked from Login + Signup. Override the displayed mailto at
# build time. José / TARS can set this without a code change.
#
# Defaults to support@openscaffoldlabs.com (Open Scaffold Labs
# mother-company support inbox) when unset. Do not point this at a
# personal founder inbox.
# VITE_PUBLIC_SUPPORT_EMAIL=support@openscaffoldlabs.com

# iOS shell (Capacitor). Leave both unset for every hosted web build.
# `npm run ios:sync` sets VITE_CAPACITOR itself. Set the second one
# only when Dale is trying the notice-permission flow. Neither value
# is a secret. Do not put them in .env.production.
#
# VITE_CAPACITOR=
# VITE_ENABLE_IOS_PUSH=
#
# Archive AI ceiling, read by ios:sync and written into the shell user
# agent. Unset means that archive has no AI. Exactly consent-required
# is the only value that can ask. A hosted page cannot raise it.
# Not a Vite variable and not a provider key.
# OC_IOS_AI_CEILING=
