# Supabase pooler connection string (port 6543, transaction mode) —
# copy from Supabase dashboard → Project Settings → Database → Connection string → Transaction.
# Direct connections (port 5432) are fine locally but unsafe for serverless.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Local dev port — the ecosystem conventions expect 3034. Do not change.
PORT=3034

# Base URL advertised back to calendar apps when generating ICS
# subscription links. In prod this should be the Vercel deployment URL.
BASE_URL=https://openchurch.vercel.app

# Long random string (32+ chars). Required in prod; insecure fallback
# warns loudly in logs when missing.
JWT_SECRET=change-me-to-a-long-random-string

# Anthropic + OpenAI API keys for AI Studio. Either one is enough;
# anthropic is tried first. Leave blank to disable that provider.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional — override the seeded demo account credentials.
# DEMO_EMAIL=demo@openchurch.app
# DEMO_PASSWORD=demo1234

# Public URL of the client app — used in email links (welcome, password
# reset). Defaults to http://localhost:5202 if unset. In prod set this
# to your Vercel deployment URL.
CLIENT_URL=http://localhost:5202

# Default From address for transactional emails. Wired into the
# placeholder email transport in server/src/email/send.js — the real
# value gets used once a provider SDK lands.
EMAIL_FROM=OpenChurch <hello@example.com>

# Billing — leave blank to run in stub mode (the default during
# development). The provider module in server/src/billing/provider.js
# treats the absence of BILLING_PROVIDER_SECRET as "use the stub";
# setting it to a real Stripe / Lemon Squeezy / Paddle secret key will
# (eventually) flip the module to the real implementation.
# BILLING_PROVIDER_SECRET=
# BILLING_WEBHOOK_SECRET=
# BILLING_PRICE_ID_PRO=

# Monitoring — leave blank to run in structured-logging-only mode (the
# default). Set to a Sentry DSN to forward monitor.error() to Sentry; this
# requires the optional @sentry/node package to be installed. If the DSN is
# set but the package is missing, monitoring logs a single warning and falls
# back to stdout/stderr logging (it never crashes the server).
SENTRY_DSN=
