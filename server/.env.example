# Supabase pooler connection string (port 6543, transaction mode) —
# copy from Supabase dashboard → Project Settings → Database → Connection string → Transaction.
# Direct connections (port 5432) are fine locally but unsafe for serverless.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Local dev port — the ecosystem conventions expect 3034. Do not change.
PORT=3034

# Base URL advertised back to calendar apps when generating ICS
# subscription links. In prod this should be the Vercel deployment URL.
BASE_URL=https://openchurch.vercel.app

# Long random string (32+ chars). Required in prod; insecure fallback
# warns loudly in logs when missing.
JWT_SECRET=change-me-to-a-long-random-string

# Anthropic + OpenAI API keys for AI Studio. Either one is enough;
# anthropic is tried first. Leave blank to disable that provider.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional — override the seeded demo account credentials.
#
# Read ONLY when the demo seed actually runs, which means a local target or
# an explicit SEED_DEMO=true. On a deployed environment these are inert: the
# seed is skipped, so nothing reads them. The value below is the historic
# default and is public — a local convenience, never a live password.
# DEMO_EMAIL=demo@openchurch.app
# DEMO_PASSWORD=demo1234

# Public URL of the client app — used in email links (welcome, password
# reset). Defaults to http://localhost:5202 if unset. In prod set this
# to your Vercel deployment URL.
CLIENT_URL=http://localhost:5202

# Default From address for transactional emails, as "Name <addr@domain>".
# The domain must be verified with the email provider before live sends
# succeed — an unverified domain fails at send time, not at boot.
EMAIL_FROM=OpenChurch <hello@example.com>

# Email delivery. Leave RESEND_API_KEY blank to run the console stub (the
# dev default): no key, no network, no accidental sends from a dev box.
# Setting it flips server/src/email/send.js to live Resend delivery — the
# check happens per call, so no redeploy is needed to change modes.
# RESEND_WEBHOOK_SECRET is the Svix signing secret ("whsec_...") from the
# provider's webhook settings; without it POST /api/email/webhook rejects
# every delivery event, so bounces and complaints are never recorded and
# the notification log will keep reporting 'sent' for dead addresses.
# RESEND_API_KEY=
# RESEND_WEBHOOK_SECRET=

# Billing — leave blank to run in stub mode (the default during
# development). The provider module in server/src/billing/provider.js
# treats the absence of BILLING_PROVIDER_SECRET as "use the stub";
# setting it to a real Stripe / Lemon Squeezy / Paddle secret key will
# (eventually) flip the module to the real implementation.
#
# BILLING_WEBHOOK_SECRET is REQUIRED whenever either billing OR giving is
# live (PAYMENTS_PROVIDER_SECRET below): one endpoint receives both, and
# every live gift is recorded from its checkout.session.completed event.
# Without it the endpoint answers every delivery 5xx so the provider keeps
# retrying, and /api/health reports payments_webhook_ready:false and
# payments_capable:false.
#
# It is also what DECIDES whether a delivery is processed at all. While it
# is set, every event is signature-verified and every verified gift is
# recorded — even after PAYMENTS_PROVIDER_SECRET has been removed or
# PAYMENTS_PROVIDER switched to stub, because Stripe still delivers the
# sessions donors already completed and the money moved regardless. Keep it
# set for as long as the endpoint is registered at Stripe; remove it only
# together with the endpoint. With no signing secret and nothing live, the
# endpoint acknowledges deliveries as stub without reading them.
# BILLING_PROVIDER_SECRET=
# BILLING_WEBHOOK_SECRET=
# BILLING_PRICE_ID_PRO=

# Monitoring — leave blank to run in structured-logging-only mode (the
# default). Set to a Sentry DSN to forward monitor.error() to Sentry; this
# requires the optional @sentry/node package to be installed. If the DSN is
# set but the package is missing, monitoring logs a single warning and falls
# back to stdout/stderr logging (it never crashes the server).
SENTRY_DSN=

# ── Push notifications (Web Push / VAPID) ────────────────────────────
# Generate a key pair with:  npx web-push generate-vapid-keys
# Both keys must be set or push silently stays off (email still sends).
# VAPID_CONTACT is the mailto: address push services contact about your
# sends; defaults to mailto:ops@openchurch.app.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_CONTACT=mailto:ops@openchurch.app

# ── Giving (what a member pays a parish) ─────────────────────────────
# Distinct from BILLING_* above, which is what OpenChurch charges the
# parish. Two concerns, two variables — setting one does not move the
# other. Blank = stub provider. Live giving also needs
# BILLING_WEBHOOK_SECRET above — that is where the gift is recorded.
# PAYMENTS_PROVIDER=
# PAYMENTS_PROVIDER_SECRET=

# ── Secrets that must be set in production ───────────────────────────
# CHECKIN_CODE_PEPPER is the HMAC key for child-pickup codes. Production
# refuses to boot without it (src/utils/pickupCode.js throws) — a pickup
# code is low-entropy, so an unpeppered hash is worth very little.
# Dev/test fall back to a fixed value with a loud warning.
# CHECKIN_CODE_PEPPER=

# CRON_SECRET authenticates the scheduled-job endpoints. If unset, those
# endpoints refuse every caller and log cron.unconfigured — a missing
# value shows up as a dead scheduler, not as a security hole.
# CRON_SECRET=

# AI_KEY_SECRET encrypts per-org AI provider keys at rest. Falls back to
# JWT_SECRET, then to a dev-only constant. Set it separately in prod so
# rotating the JWT signing key does not strand every stored AI key.
# AI_KEY_SECRET=

# ── Founder / vendor access ──────────────────────────────────────────
# SUPER_ADMIN_EMAIL is the founder's notification address (backup digest).
# Since F-01 it grants NO access, and neither does VENDOR_ADMIN_EMAILS; see
# SUPER_ADMIN_USER_IDS / VENDOR_ADMIN_USER_IDS below. /api/admin/* returns
# 404 rather than 403 to anyone not listed.
# SUPER_ADMIN_EMAIL=
# VENDOR_ADMIN_EMAILS=
# AI_SWITCH_OPERATOR_USER_IDS: comma-separated ochr_users ids allowed to read,
# stop and resume platform AI at /api/admin/ai-switch (Stage 7). Bound to the
# user id, not the JWT email. Unset means nobody (404), fail closed.
# AI_SWITCH_OPERATOR_USER_IDS=
# F-01: founder / vendor privilege is granted ONLY by these comma-separated
# ochr_users ids. SUPER_ADMIN_EMAIL / VENDOR_ADMIN_EMAILS grant nothing.
# Unset means nobody (404 / no vendor scope), fail closed. Verify each id
# out of band before setting it; no migration or login sets these.
# SUPER_ADMIN_USER_IDS=
# VENDOR_ADMIN_USER_IDS=

# Where support tickets are forwarded. Unset = tickets are stored but
# nothing is emailed out.
# SUPPORT_EMAIL=

# ── Front-end origins ────────────────────────────────────────────────
# The chancery client, so a diocese invitation links to :5204 rather than
# dropping a chancery user into the parish app.
DIOCESE_CLIENT_URL=http://localhost:5204

# Extra browser origins allowed to make cross-origin API calls, comma
# separated. CLIENT_URL and DIOCESE_CLIENT_URL are always allowed.
# Outside production, localhost is allowed automatically so dev needs
# no setup. Cookie sessions (SameSite=Lax) use this same allowlist as
# the CSRF Origin check on mutations that carry ochr_session.
# CORS_ORIGINS=

# ── Tuning (sensible defaults; override only with a reason) ──────────
# Postgres pool size per serverless instance. Small on purpose — the
# Supavisor pooler does the real connection reuse. Default 5.
# PG_POOL_MAX=5

# Log threshold: debug | info | warn | error. Default info.
# MONITORING_LEVEL=info

# Support assistant model and its per-org daily message cap (default 300).
# SUPPORT_AI_MODEL=
# ASSISTANT_DAILY_CAP=300

# Platform AI budget for the durable ledger (ai/ledger.js, ochr_ai_ledger),
# in DOLLARS per UTC calendar month. Applies to platform-managed calls that
# are accounted (the in-app assistant today), never to a parish's own key.
# Unset uses the conservative defaults shown; a malformed value refuses AI
# rather than falling back. The real amounts are an open decision (José).
# AI_BUDGET_PARISH_MONTHLY_USD=5
# AI_BUDGET_TOTAL_MONTHLY_USD=25

# ── Demo data ────────────────────────────────────────────────────────
# Dev and test seed the local demo org. Production skips it unless this
# is explicitly "true". Do not set SEED_DEMO=true against production to
# provision App Store reviewers — that is a live write, and this flag
# does not rotate or delete the historic production demo@ row. App
# Review uses the isolated tenant below (docs/APP-REVIEW-TENANT.md).
# SEED_DEMO=false

# ── App Review tenant (non-prod only) ────────────────────────────────
# Throwaway reviewer sandbox. Off unless SEED_APP_REVIEW_TENANT is 1/true.
# Email, password, and org name have no defaults — they come from env,
# never from the client bundle. NODE_ENV=production is refused. A remote
# DATABASE_URL also needs APP_REVIEW_ALLOW_REMOTE=1. Never the public
# demo pair (demo@openchurch.app / demo1234 / demo-church).
# SEED_APP_REVIEW_TENANT=
# APP_REVIEW_EMAIL=
# APP_REVIEW_PASSWORD=
# APP_REVIEW_ORG_NAME=
# APP_REVIEW_ORG_SLUG=
# APP_REVIEW_USER_NAME=
# APP_REVIEW_ALLOW_REMOTE=

# ── Test harness (never production) ──────────────────────────────────
# Vitest sets VITEST=true. Only the values true or 1 re-open Bearer for
# the test suite. Production deploys must leave this unset — a stray
# value must not restore Authorization: Bearer.
# VITEST=
